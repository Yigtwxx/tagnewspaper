# Copy to web/.env.local for local development. Never commit real values.

# Read-only MongoDB user (web_ro). Leave empty to render the empty state.
MONGODB_URI=
MONGODB_DB=tagnewspaper

# Shared with the pipeline; at least 32 random characters.
REVALIDATE_SECRET=

# Public values (end up in the browser bundle).
NEXT_PUBLIC_SITE_URL=https://tagnewspaper.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PUBLISHER_NAME=

# Local preview with the fictional fixture in shared/fixtures (ignored on Vercel production).
TAGNEWS_DEMO_DATA=0
