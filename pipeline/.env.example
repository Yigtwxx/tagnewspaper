# Copy to `.env` and fill in. Never commit the real file.

# Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Model used for summaries; Claude Haiku 5.5 is cheap and fast enough here.
ANTHROPIC_MODEL=claude-haiku-5-5

# MongoDB Atlas connection string for the read-write user `pipeline_rw`
MONGODB_URI=
MONGODB_DB=tagnewspaper

# Next.js on-demand revalidation (web/app/api/revalidate)
REVALIDATE_URL=https://tagnewspaper.vercel.app/api/revalidate
REVALIDATE_SECRET=

# Fetch article pages (robots.txt respected) so the model summarizes real text.
FETCH_FULLTEXT=true
# Override only to test the fallback chain (e.g. point it at a dead host).
GOOGLE_NEWS_BASE_URL=https://news.google.com/rss/search
# Per-run limits (GitHub Actions timeout is 10 minutes).
MAX_ITEMS_PER_RUN=25
MAX_DECODES_PER_RUN=40

LOG_LEVEL=INFO
